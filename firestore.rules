rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVaultOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function isValidVaultPayload(vault) {
      return vault is map
        && vault.keys().hasAll([
          'items',
          'log',
          'profile',
          'settings',
          'notes'
        ])
        && vault.keys().hasOnly([
          'items',
          'log',
          'profile',
          'settings',
          'notes'
        ])
        && vault.items is list
        && vault.items.size() <= 1000
        && vault.log is list
        && vault.log.size() <= 2500
        && vault.profile is map
        && vault.settings is map
        && vault.notes is list
        && vault.notes.size() <= 1000;
    }

    function isValidVaultDocument() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'schemaVersion',
          'vault',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'vault',
          'updatedAt',
          'updatedBy'
        ])
        && data.schemaVersion is int
        && data.schemaVersion == 4
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.updatedBy is string
        && data.updatedBy.size() >= 1
        && data.updatedBy.size() <= 128
        && isValidVaultPayload(data.vault);
    }

    // PicSecure Renew stores one private cloud-vault document per account.
    // Direct document reads are allowed only to its authenticated owner.
    match /users/{userId}/vault/main {
      allow get: if isVaultOwner(userId);
      allow list: if false;
      allow create, update: if isVaultOwner(userId)
        && isValidVaultDocument();
      allow delete: if isVaultOwner(userId);
    }

    // Deny every unrecognized collection and document by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
