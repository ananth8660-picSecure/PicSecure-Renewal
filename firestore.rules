rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVaultOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function isValidVaultPayload(vault) {
      return vault is map
        && vault.keys().hasAll([
          'items',
          'log',
          'profile',
          'settings',
          'notes'
        ])
        && vault.keys().hasOnly([
          'items',
          'log',
          'profile',
          'settings',
          'notes'
        ])
        && vault.items is list
        && vault.items.size() <= 1000
        && vault.log is list
        && vault.log.size() <= 2500
        && vault.profile is map
        && vault.settings is map
        && vault.notes is list
        && vault.notes.size() <= 1000;
    }

    function isValidVaultDocument() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'schemaVersion',
          'vault',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'vault',
          'updatedAt',
          'updatedBy'
        ])
        && data.schemaVersion is int
        && data.schemaVersion == 4
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.updatedBy is string
        && data.updatedBy.size() >= 1
        && data.updatedBy.size() <= 128
        && isValidVaultPayload(data.vault);
    }

    // PicSecure Renew stores one private cloud-vault document per account.
    // Direct document reads are allowed only to its authenticated owner.
    match /users/{userId}/vault/main {
      allow get: if isVaultOwner(userId);
      allow list: if false;
      allow create, update: if isVaultOwner(userId)
        && isValidVaultDocument();
      allow delete: if isVaultOwner(userId);
    }

    // Images and PDFs attached to thoughts: each file is stored as chunks under 1 MiB
    // (users/{uid}/files/{fileId}/chunks/{index}). Only the owner can read, add or delete
    // them; chunks are never changed in place and cannot be listed.
    function isValidFileChunk(chunkId) {
      let data = request.resource.data;
      return data.keys().hasAll(['data', 'i', 'n'])
        && data.keys().hasOnly(['data', 'i', 'n'])
        && data.data is bytes
        && data.data.size() >= 1
        && data.data.size() <= 921600
        && data.i is int
        && data.n is int
        && data.n >= 1
        && data.n <= 18
        && data.i >= 0
        && data.i < data.n
        && chunkId == string(data.i);
    }

    match /users/{userId}/files/{fileId}/chunks/{chunkId} {
      allow get: if isVaultOwner(userId);
      allow list: if false;
      allow create: if isVaultOwner(userId)
        && fileId.size() >= 8
        && fileId.size() <= 64
        && isValidFileChunk(chunkId);
      allow update: if false;
      allow delete: if isVaultOwner(userId);
    }

    // Deny every unrecognized collection and document by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
