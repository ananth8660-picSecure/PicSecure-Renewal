# Comma-separated Label:project-id allowlist. Never expose arbitrary projects.
FIREBASE_MONITOR_PROJECTS=Development:pic-dev-f28a7,Staging:pic-staging-37f03,Production:pic-87b28

# Backend-only Google Cloud service account with Monitoring Viewer role.
# Enable monitoring.googleapis.com on each Firebase project first.
GOOGLE_SERVICE_ACCOUNT_EMAIL=picsecure-renew-monitor@pic-dev-f28a7.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Cross-origin access for the Android/iOS webview and the local web app.
# Add your deployed web origin after publishing, separated by a comma.
PICSECURE_ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost,http://localhost:5173

# Public Firebase Web App configuration used for Email/Password Auth + Firestore sync.
# These values identify your Firebase app; they are not a service-account secret.
# Use the Production Firebase project's Web App values for release EXE/APK builds.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# HTTPS origin of the deployed PicSecure Renew API used by EXE/APK builds.
# Example: https://renew-api.example.workers.dev (no trailing slash)
VITE_PICSECURE_API_BASE=
