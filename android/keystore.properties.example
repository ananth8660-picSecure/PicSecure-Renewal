# Copy this file to android/keystore.properties and replace every placeholder.
# Use forward slashes in Windows paths. Never commit the real file or keystore.
storeFile=C:/Users/YOUR_WINDOWS_USER/PicSecureKeys/picsecure-renew-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=picsecure-renew
keyPassword=YOUR_KEY_PASSWORD
